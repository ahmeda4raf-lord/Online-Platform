        <mxCell id="progress" value="&lt;b&gt;LessonProgressRecords&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;10&quot;&gt;Entity: LessonProgress&lt;/font&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;FK StudentId : nvarchar(450) NOT NULL&lt;br&gt;FK LessonId : int NOT NULL&lt;br&gt;IsCompleted : bit NOT NULL&lt;br&gt;CompletedAt : datetime2 NULL&lt;br&gt;&lt;b&gt;UQ (StudentId, LessonId)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#b45f06;fontColor=#783f04;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
