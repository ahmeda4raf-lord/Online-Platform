        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = Primary Key &amp;nbsp; FK = Foreign Key &amp;nbsp; UQ = Unique index&lt;br&gt;Solid connectors show one-to-many relationships; labels show delete behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#7f8c8d;fontColor=#34495e;align=left;spacing=10;" vertex="1" parent="1">
