        <mxCell id="categories" value="&lt;b&gt;Categories&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;Name : nvarchar(100) NOT NULL&lt;br&gt;Description : nvarchar(max) NOT NULL&lt;br&gt;CreatedAt : datetime2 NOT NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#4f7f43;fontColor=#1f3d1a;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="320" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="courses" value="&lt;b&gt;Courses&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;Title : nvarchar(max) NOT NULL&lt;br&gt;Description : nvarchar(max) NOT NULL&lt;br&gt;Price : decimal(18,2) NOT NULL&lt;br&gt;Level : nvarchar(max) NOT NULL&lt;br&gt;ThumbnailUrl : nvarchar(max) NOT NULL&lt;br&gt;Status : int NOT NULL&lt;br&gt;RejectionReason : nvarchar(max) NULL&lt;br&gt;FK InstructorId : nvarchar(450) NOT NULL&lt;br&gt;FK CategoryId : int NOT NULL&lt;br&gt;CreatedAt : datetime2 NOT NULL&lt;br&gt;UpdatedAt : datetime2 NOT NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3d6d99;fontColor=#17365d;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="155" width="385" height="315" as="geometry"/>
        </mxCell>
        <mxCell id="sections" value="&lt;b&gt;CourseSections&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;Title : nvarchar(max) NOT NULL&lt;br&gt;Order : int NOT NULL&lt;br&gt;FK CourseId : int NOT NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#3d6d99;fontColor=#17365d;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="180" width="330" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="lessons" value="&lt;b&gt;Lessons&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;Title : nvarchar(max) NOT NULL&lt;br&gt;Content : nvarchar(max) NOT NULL&lt;br&gt;VideoUrl : nvarchar(max) NOT NULL&lt;br&gt;Order : int NOT NULL&lt;br&gt;IsPreview : bit NOT NULL&lt;br&gt;FK CourseSectionId : int NOT NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#3d6d99;fontColor=#17365d;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="510" width="350" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="enrollments" value="&lt;b&gt;Enrollments&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : int&lt;br&gt;FK StudentId : nvarchar(450) NOT NULL&lt;br&gt;FK CourseId : int NOT NULL&lt;br&gt;EnrolledAt : datetime2 NOT NULL&lt;br&gt;ProgressPercentage : float NOT NULL&lt;br&gt;IsCompleted : bit NOT NULL&lt;br&gt;&lt;b&gt;UQ (StudentId, CourseId)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#b45f06;fontColor=#783f04;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
