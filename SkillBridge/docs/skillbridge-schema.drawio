        </mxCell>
        <mxCell id="rules-note" value="&lt;b&gt;Model notes&lt;/b&gt;&lt;br&gt;Navigation collection properties are not database columns.&lt;br&gt;String columns without explicit MaxLength map to nvarchar(max).&lt;br&gt;All FK properties shown are required by the current non-nullable CLR types." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f3f3f3;strokeColor=#888888;fontColor=#444444;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="320" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;AspNetUsers&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;10&quot;&gt;Entity: ApplicationUser : IdentityUser&lt;/font&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot;&gt;PK Id : nvarchar(450)&lt;br&gt;UserName : nvarchar(256) NULL&lt;br&gt;NormalizedUserName : nvarchar(256) NULL [index]&lt;br&gt;Email : nvarchar(256) NULL&lt;br&gt;NormalizedEmail : nvarchar(256) NULL [index]&lt;br&gt;EmailConfirmed : bit NOT NULL&lt;br&gt;PasswordHash : nvarchar(max) NULL&lt;br&gt;SecurityStamp : nvarchar(max) NULL&lt;br&gt;ConcurrencyStamp : nvarchar(max) NULL&lt;br&gt;PhoneNumber : nvarchar(max) NULL&lt;br&gt;PhoneNumberConfirmed : bit NOT NULL&lt;br&gt;TwoFactorEnabled : bit NOT NULL&lt;br&gt;LockoutEnd : datetimeoffset NULL&lt;br&gt;LockoutEnabled : bit NOT NULL&lt;br&gt;AccessFailedCount : int NOT NULL&lt;br&gt;&lt;b&gt;FullName : nvarchar(max) NOT NULL&lt;br&gt;CreatedAt : datetime2 NOT NULL&lt;br&gt;IsBlocked : bit NOT NULL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7791f;fontColor=#5f370e;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
