        <mxCell id="title" value="&lt;b&gt;SkillBridge Database Schema&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;12&quot;&gt;EF Core domain model + ASP.NET Core Identity (SQL Server)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#17324d;" vertex="1" parent="1">
