          <mxGeometry x="30" y="110" width="1470" height="1390" as="geometry"/>
        </mxCell>
        <mxCell id="identity-group" value="ASP.NET CORE IDENTITY TABLES" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#fff1d6;swimlaneFillColor=#fffdf8;strokeColor=#b7791f;fontColor=#5f370e;fontStyle=1;fontSize=15;" vertex="1" parent="1">
